.figure .figsub{font-size:13.5px;color:var(--a-text-muted);margin-bottom:18px}
.legend{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:13px;color:var(--a-text-muted);margin-top:4px}
.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:7px;vertical-align:-1px}

/* ranking chart */
.rank-row{display:grid;grid-template-columns:188px 58px 1fr 64px;align-items:center;gap:12px;padding:5px 0}
.rank-row .nm{font-size:13.5px;font-weight:500;color:var(--a-text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rank-row .nm small{color:var(--a-text-muted);font-weight:400}
.bar-track{background:var(--a-lightest-green-black);border-radius:6px;height:18px;position:relative;overflow:hidden}
.bar-fill{height:100%;border-radius:6px;transition:width .9s cubic-bezier(.2,.7,.3,1)}
.rank-row .sc{font-size:13px;font-variant-numeric:tabular-nums;color:var(--a-text-muted);text-align:right} .rank-row .cov{font-size:12px;color:var(--a-text-muted);font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}
.rank-row .sc.na{color:var(--a-text-muted)}
@media(max-width:620px){.rank-row{grid-template-columns:96px 46px 1fr 48px;gap:8px}.rank-row .nm small{display:none}}

/* timeline */
#timeline{width:100%;overflow:visible}
.tl-dot{cursor:pointer}
.tl-axis line{stroke:var(--a-border)}
.tl-axis text{fill:var(--a-text-muted);font-size:11px;font-family:var(--a-font-body)}

/* graph */
.graph-loading{padding:24px;color:var(--a-text-muted);font-size:14px;text-align:center}
#graph{width:100%;height:560px;background:linear-gradient(180deg,#fbfdfd,#f3f8f7);
  border:1px solid var(--a-border);border-radius:16px;position:relative;overflow:hidden;margin-top:30px}
.gtip{position:absolute;pointer-events:none;background:var(--a-darker-kale);color:#fff;
  padding:7px 11px;border-radius:8px;font-size:12.5px;opacity:0;transition:opacity .12s;
  box-shadow:0 6px 20px rgba(16,41,44,.25);max-width:220px}
.gtip b{color:var(--a-light-kale)}

/* ---- featured cards ---- */
.feat{display:grid;grid-template-columns:1fr;gap:24px;margin-top:46px}
.fcard{background:var(--a-white);border:1px solid var(--a-border);border-radius:16px;overflow:hidden;
  box-shadow:0 1px 3px rgba(16,41,44,.05);display:grid;grid-template-columns:1.35fr 1fr}
@media(max-width:780px){.fcard{grid-template-columns:1fr}}
.fcard .left{padding:30px 30px 28px;border-right:1px solid var(--a-border)}
@media(max-width:780px){.fcard .left{border-right:none;border-bottom:1px solid var(--a-border)}}
.fcard .right{padding:28px 28px;background:var(--a-lightest-kale)}
.fhead{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.fhead .rk{font-family:var(--a-font-heading);font-size:1.5rem;font-weight:700;color:var(--a-opal);line-height:1}
.fhead h3{font-size:1.5rem;font-family:var(--a-font-heading);font-weight:700;letter-spacing:-0.3px}
.fcard .desc{font-size:15.5px;margin-top:16px;color:var(--a-text-muted)}
.badge{font-size:11.5px;font-weight:600;padding:3px 11px;border-radius:20px;letter-spacing:.2px;white-space:nowrap}
.badge.live{background:var(--a-lightest-emerald);color:#256b25;border:1px solid #bfe3bd}
.badge.warm{background:var(--a-lighter-kale);color:#235c63;border:1px solid #bfe0e3}
.badge.stable{background:var(--a-lightest-green-black);color:#5d6b67;border:1px solid var(--a-border)}
.badge.na{background:var(--a-lightest-green-black);color:var(--a-text-muted);border:1px solid var(--a-border)}
.badge.wild{background:#fff;color:var(--a-emerald);border:1px dashed #9bcc98}
.badge.canon{background:#fff;color:var(--a-kale);border:1px solid #bfe0e3}
.chips{margin-top:18px}
.chip{display:inline-block;background:var(--a-white);border:1px solid var(--a-border);border-radius:20px;
  padding:4px 12px;margin:0 6px 8px 0;font-size:12.5px;color:var(--a-text-muted)}
.chip.bridge{background:var(--a-lightest-emerald);border-color:#cbe7c9;color:#2c6b2b}
.meta-row{display:flex;gap:8px;padding:9px 0;border-bottom:1px dashed var(--a-border);font-size:13.5px}
.meta-row:last-child{border-bottom:none}
.meta-row .k{flex:0 0 96px;color:var(--a-text-muted);font-weight:500}
.meta-row .v{flex:1;color:var(--a-text)}
.fcard .rlabel{font-size:12.5px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:var(--a-kale);margin-bottom:12px}
.mix-bar{display:flex;height:14px;border-radius:7px;overflow:hidden;margin:6px 0 12px}
.mix-bar span{display:block;height:100%}
.mix-key{font-size:12.5px;color:var(--a-text-muted);line-height:1.7}
.mix-key i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:0}
.example{margin-top:14px;background:var(--a-white);border:1px solid var(--a-border);border-radius:10px;padding:13px 15px;font-size:13px;line-height:1.55}
.example .et{color:var(--a-text-muted)}

/* ---- catalog table ---- */
.tablewrap{margin-top:38px;border:1px solid var(--a-border);border-radius:14px;overflow:hidden;background:var(--a-white)}
table{width:100%;border-collapse:collapse;font-size:14px}
thead th{background:var(--a-lightest-green-black);text-align:left;padding:14px 16px;font-size:12px;
  font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:#5d6b67;cursor:pointer;user-select:none;white-space:nowrap}
thead th.sortable:hover{color:var(--a-text)}
.th-btn{all:unset;display:block;width:100%;cursor:pointer;font:inherit;color:inherit;
  letter-spacing:inherit;text-transform:inherit}
.th-btn:focus-visible{outline:2px solid var(--a-emerald);outline-offset:2px;border-radius:3px}
thead th .ar{color:var(--a-emerald);font-size:10px}
tbody td{padding:13px 16px;border-top:1px solid var(--a-border);vertical-align:middle}
tbody tr:hover{background:var(--a-lightest-kale)}
td.rk{color:var(--a-text-muted);font-variant-numeric:tabular-nums;width:38px}
td.role{font-weight:600;color:var(--a-text)}
td.mix{color:#5d6b67;font-size:13px}
.minibar{display:inline-flex;align-items:center;gap:9px;width:130px}
.minibar .mt{flex:1;height:8px;background:var(--a-lightest-green-black);border-radius:4px;overflow:hidden}
.minibar .mf{display:block;height:100%;border-radius:4px}
.minibar .mv{font-variant-numeric:tabular-nums;font-size:12.5px;color:var(--a-text-muted);width:34px;text-align:right}
/* recency band chips (table + featured) */
.ryear{font-variant-numeric:tabular-nums;font-weight:600;margin-right:8px;color:var(--a-text-muted)}
.rband{display:inline-block;font-size:11px;font-weight:600;padding:2px 9px;border-radius:20px;white-space:nowrap}
.rband.emerging{background:#E7F5E7;color:#2c7a2b}
.rband.recent{background:#E2F0F1;color:#2b7079}
.rband.settled{background:#eef2f0;color:#5f7b74}
.rband.na{background:#f1f4f3;color:var(--a-text-muted)}
.rdated{display:block;font-size:10px;color:var(--a-text-muted);margin-top:2px}
.chips-cap{font-size:11.5px;line-height:1.5;color:var(--a-text-muted);margin:14px 0 2px}
.blegend{margin:18px 0 2px;font-size:12.5px;color:var(--a-text-muted);display:flex;flex-direction:column;gap:9px}
.blegend .row{display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;line-height:1.55}
.blegend .row>span:last-child{flex:1 1 260px;min-width:200px}
.blegend .badge{flex:none}
/* scatter (emergence map) */
.sc-axis line{stroke:var(--a-border)}
.sc-axis text{fill:var(--a-text-muted);font-size:11px;font-family:var(--a-font-body)}
.sc-axis .axlabel{fill:#5f7b74;font-size:11.5px;font-weight:600}
.sc-quad{fill:var(--a-text-muted);font-size:10.5px;font-weight:600;letter-spacing:.03em;text-transform:uppercase}
.sc-lane{fill:#f3f7f6}
.sc-dot{cursor:pointer}
.cov{font-variant-numeric:tabular-nums}
@media(max-width:720px){.hide-sm{display:none}}
/* ---- expandable catalog rows ---- */
tbody tr.crow{cursor:pointer}
tbody tr.crow:focus-visible{outline:2px solid var(--a-emerald);outline-offset:-2px}
td.rk .chev{display:inline-block;margin-right:7px;color:var(--a-light-kale);font-size:11px;
  transition:transform .2s ease;transform:rotate(0deg);vertical-align:1px}
tbody tr.crow.is-open{background:var(--a-lightest-kale)}
tbody tr.crow.is-open .chev{transform:rotate(90deg);color:var(--a-emerald)}
tr.detail-row > td{padding:0;border-top:none}
tr.detail-row .fcard{border-radius:0;border-left:none;border-right:none;border-bottom:none;
  box-shadow:none;animation:detailIn .35s cubic-bezier(.2,.7,.3,1)}
@keyframes detailIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}

/* ---- validation ---- */
.valgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:44px}
@media(max-width:760px){.valgrid{grid-template-columns:repeat(2,1fr)}}
.valcard{background:var(--a-white);border:1px solid var(--a-border);border-radius:14px;padding:26px 22px;text-align:center}
.valcard .vn{font-family:var(--a-font-heading);font-size:2.3rem;font-weight:700;color:var(--a-emerald);line-height:1}
.valcard .vl{font-size:13px;color:#5d6b67;margin-top:10px;line-height:1.4}
.recall{background:var(--a-white);border:1px solid var(--a-border);border-radius:14px;padding:28px 30px;margin-top:26px}
.recall h3{font-size:1.1rem;margin-bottom:6px}
.recall .rrow{display:flex;gap:12px;padding:11px 0;border-bottom:1px solid var(--a-border);font-size:14.5px;align-items:baseline}
.recall .rrow:last-child{border-bottom:none}
.recall .ck{color:var(--a-emerald);font-weight:700}
.recall .rrow.miss{opacity:.72}
.recall .rrow.miss .ck{color:#b06a4e}
.recall .known{font-weight:600;color:var(--a-text);flex:0 0 165px}
.recall .arrow{color:var(--a-text-muted)}
.recall .into{color:var(--a-text-muted)}
.recall .sk{color:var(--a-text-muted);font-size:12.5px}
@media(max-width:620px){.recall .known{flex-basis:120px}.recall .sk{display:none}}

/* ---- limitations ---- */
.limits{display:grid;grid-template-columns:1fr 1fr;gap:18px 40px;margin-top:40px}
