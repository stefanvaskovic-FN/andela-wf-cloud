.lim{display:flex;gap:14px;align-items:flex-start}
.lim .dot{flex:0 0 8px;width:8px;height:8px;border-radius:50%;background:var(--a-opal);margin-top:9px}
.lim h3{font-size:1rem;margin-bottom:2px}
.lim p{margin-top:4px;font-size:14.5px;color:var(--a-text-muted)}

/* ---- closing ---- */
.closing .a-container{max-width:820px}
.closing .a-eyebrow{color:var(--a-light-kale)}
.closing h2{font-family:var(--a-font-heading);font-weight:400;font-size:clamp(1.8rem,3.4vw,2.6rem);line-height:1.2;margin-top:16px;color:#fff}
.closing p{color:#cfe0dd;font-size:1.08rem}
.repro{margin-top:34px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);
  border-radius:12px;padding:18px 22px;font-size:13.5px;color:#a9c6c1}
.repro code{background:rgba(0,0,0,.25);padding:2px 7px;border-radius:5px;color:#cfe0dd;font-size:12.5px}
.foot{border-top:1px solid var(--a-border);padding:34px 0;background:var(--a-almost-white)}
.foot .a-container{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px}
.foot img{height:20px}
.foot .fz{font-size:12.5px;color:var(--a-text-muted)}

.fade{opacity:0;transform:translateY(14px)}
.fade.in{opacity:1;transform:none;transition:opacity .7s ease,transform .7s ease}

</style>

