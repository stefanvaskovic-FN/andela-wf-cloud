---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { reportBySlug } from '../../data/reports-registry';
import { withBase } from '../../lib/base';

// Slug MUST match this file's name — see src/data/reports-registry.ts.
const report = reportBySlug('emergent-roles')!;
import { CANDS, VAL, fmt, bleedRankMap, type Candidate } from '../../reports/emergent-roles/data/roles';
import { cardHTML } from '../../reports/emergent-roles/scripts/explorer';
import { TOP_SKILLS } from '../../reports/emergent-roles/data/topSkills';

// This file's path (src/pages/reports/emergent-roles.astro) IS the URL:
// /reports/emergent-roles here (Webflow Cloud adds the /research or /research-staging prefix externally). No registry, no draft/publish switch —
// staging vs. production is handled by which git branch is deployed to
// which Webflow Cloud environment (/research-staging vs /research), not by
// anything in this file.

// Astro NE prepisuje doslovne stringove u HTML atributima — svaki asset
// ispod ide kroz withBase(). Vidi src/lib/base.ts.
const topSkills = TOP_SKILLS;

const title = 'Emergent role classification from skill mapping · Andela Research';
const description = 'Detecting emergent software roles in Fortune 500 hiring through cross-boundary skill bleed: 47,101 postings, 2,026 skills, 23 candidate roles.';

const schema = {
  '@context': 'https://schema.org',
  // '@type' on the root alongside '@graph' satisfies audit tools that expect
  // every top-level JSON-LD block to declare a type; the entities that
  // actually matter for rich results are the typed items inside '@graph'.
  '@type': 'WebPage',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.andela.com/#organization',
      name: 'Andela',
      url: 'https://www.andela.com/',
      logo: 'https://www.andela.com/images/andela-logo.png',
      sameAs: ['https://www.linkedin.com/company/andela/', 'https://x.com/andela'],
    },
    {
      '@type': 'Dataset',
      '@id': 'https://www.andela.com/research/reports/emergent-roles#dataset',
      name: 'Emergent Role Explorer: skill bleed across Fortune 500 tech hiring',
      description: 'Skill co-occurrence measures derived from 47,101 Fortune 500 job postings, scoring 2,026 skills and 23 candidate emergent-role clusters.',
      url: 'https://www.andela.com/research/reports/emergent-roles',
      keywords: ['emergent roles', 'skill adjacency', 'AI and tech jobs', 'job posting analysis', 'workforce research'],
      creator: { '@id': 'https://www.andela.com/#organization' },
      publisher: { '@id': 'https://www.andela.com/#organization' },
      datePublished: '2026-06-16',
      dateModified: '2026-06-16',
      isAccessibleForFree: true,
      variableMeasured: [
        { '@type': 'PropertyValue', name: 'Cross-role bleed', description: "Rate at which a skill appears in postings for roles other than its home role, relative to chance" },
        { '@type': 'PropertyValue', name: 'Emergence score', description: "Combines share of skills born 2023 or later with normalized median technology birth year" },
        { '@type': 'PropertyValue', name: 'Median vintage', description: "Median first-release year of the technologies in a candidate bundle" },
      ],
      measurementTechnique: 'Community detection over a skill co-occurrence graph built from job posting text',
      size: '47101 job postings; 2026 skills; 23 candidate emergent-role clusters; 2713 sampled cross-role edges',
    },
    {
      '@type': 'ScholarlyArticle',
      '@id': 'https://www.andela.com/research/reports/emergent-roles#article',
      headline: 'Emergent role classification from skill mapping',
      description,
      author: { '@type': 'Person', name: 'Cory Hymel', jobTitle: 'Head of Research', worksFor: { '@id': 'https://www.andela.com/#organization' } },
      publisher: { '@id': 'https://www.andela.com/#organization' },
      datePublished: '2026-06-16',
      dateModified: '2026-06-16',
      isBasedOn: { '@id': 'https://www.andela.com/research/reports/emergent-roles#dataset' },
      about: [
        { '@type': 'Thing', name: 'Software engineering occupations' },
        { '@type': 'Thing', name: 'Artificial intelligence and labour markets' },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Andela', item: 'https://www.andela.com/' },
        { '@type': 'ListItem', position: 2, name: 'Research', item: 'https://www.andela.com/research' },
        { '@type': 'ListItem', position: 3, name: 'Emergent Role Explorer' },
      ],
    },
  ],
};

const bleedRank = bleedRankMap();
function recencyCell(c: Candidate) {
  if (c.emergence === null || c.median_vintage == null) return { band: 'na' as const, label: 'not scored', yr: undefined as number | undefined };
  const yr = c.median_vintage;
  if (yr >= 2018) return { band: 'emerging' as const, label: 'Emerging', yr };
  if (yr >= 2010) return { band: 'recent' as const, label: 'Recent', yr };
  return { band: 'settled' as const, label: 'Settled', yr };
}
function summaryMix(m: Record<string, number>) {
  const tot = Object.values(m).reduce((s, x) => s + x, 0);
  return Object.entries(m).slice(0, 3).map(([r, v]) => `${r} ${Math.round((100 * v) / tot)}%`).join(' · ');
}
// Default server-rendered sort matches the client script's initial state (bleed, desc)
// so the prerendered HTML and the first client render are identical — see
// src/scripts/explorer.ts, which skips re-inserting content that's already here.
const initialRows = [...CANDS].sort((a, b) => (b.bleed ?? -1) - (a.bleed ?? -1));
---

<BaseLayout title={title} description={description} noindex={report.status !== 'published'} schema={schema}>

<Fragment slot="header">
<header class="masthead">
  <div class="a-container">
    <div class="brand">
      <img src={withBase('images/andela-logo.png')} alt="Andela" width="95" height="24" loading="eager">
      <span class="div"></span>
      <span class="tag">Research</span>
    </div>
    <nav class="topnav">
      <a href="#goal">Goal</a>
      <a href="#method">Method</a>
      <a href="#landscape">Findings</a>
      <a href="#validation">Validation</a>
      <a href="#limits">Limitations</a>
    </nav>
  </div>
</header>

</Fragment>

<!-- ================= HERO ================= -->
<div class="hero">
  <svg class="spark-field" aria-hidden="true"><defs>
    <pattern id="sparks" width="120" height="120" patternUnits="userSpaceOnUse" patternTransform="rotate(8)">
      <path d="M60 30C60 30 63 57 60 60C57 63 30 60 30 60C30 60 57 57 60 60C63 63 60 90 60 90C60 90 57 63 60 60C63 57 90 60 90 60C90 60 63 63 60 60C57 57 60 30 60 30Z" fill="#7CBFC7"/>
    </pattern></defs>
    <rect width="100%" height="100%" fill="url(#sparks)"/>
  </svg>
  <div class="a-container">
    <span class="a-eyebrow">Andela Research · Workforce intelligence</span>
    <h1 class="serif">Emergent role classification from skill mapping</h1>
    <p class="dek">Every few years a new engineering role forms where two older ones overlap. Dev plus Sec plus Ops became DevSecOps. A software engineer who picked up statistics and model training became an ML Engineer. This study detects these new roles as they form by analyzing 47,101 Fortune&nbsp;500 software job postings against a map of what each established role was historically supposed to require.</p>
    <div class="meta">A cross-sectional study of US Fortune 500 software hiring · June 2026</div>
    <div class="meta"><b>Author:</b> Cory Hymel · Head of Research, Andela</div>
  </div>
</div>

<!-- ================= STAT STRIP ================= -->
<div class="statstrip">
  <div class="a-container">
    <div class="stat"><div class="num">47,101</div><div class="lbl">Fortune 500 software postings analyzed</div></div>
    <div class="stat"><div class="num">2,026</div><div class="lbl">Distinct skills scored and placed</div></div>
    <div class="stat"><div class="num">23</div><div class="lbl">Emergent role candidates detected</div></div>
  </div>
</div>

<!-- ================= GOAL ================= -->
<section id="goal">
  <div class="a-container">
    <span class="a-eyebrow kicker">The question</span>
    <h2 class="head">What we set out to find</h2>
    <div class="narrow">
    <p class="lead">Job titles lag the work. A company hires a "data scientist" and then asks them to ship LLM agents; it posts for a "security engineer" who turns out to live inside the deployment pipeline. The skills move first, and the title catches up years later. At Andela we're obsessed with identifying these shifts early and this study is a lens into how we catch that movement while it is happening.</p>

    <div class="pull serif pull--wide">An emergent role is a stabilized pattern of skill "bleed" across historically distinct roles. More formally we define it as a recurring bundle of skills whose canonical homes belong to different jobs.</div>

    <p>This is how the ML Engineer formed in the gap between software engineering and statistics, how DevSecOps formed between development, security, and operations, and it may be how the AI Agent Developer is forming right now between backend engineering and LLM orchestration (spoiler: our data says not yet; see finding 02). A role emerges in the seam between two older ones as their skill sets <i>bleed</i> together.</p>

    <h3 class="serif" style="font-size:1.35rem;margin-top:42px">Detecting emergence without a clock</h3>
    <p>Emergence usually means change over time, but this corpus is a single five-week snapshot (30 March to 2 May 2026) of job postings pulled from current, publicly facing Fortune 500 job boards. So we reframed "historical" as structure rather than date with every established role requiring a certain set of skills. These skill mappings are from Andela's internal skill taxonomy, which we use to identify emerging skill bundles. We measure how far the postings have drifted from that baseline, and we date the technologies involved: a skill bundle built on tools born in the last three years (2023 or later, against a corpus collected in 2026) is emergent by construction, while one built on decade-old tools is a hybrid that already settled. Canonical drift plus technology vintage stand in for the missing time axis.</p>

    <p class="muted" style="font-size:15px">We have a wider thesis on <strong>talent debt</strong>, which is that skill half-lives are shrinking from roughly a decade to a couple of years or less. We cannot measure half-life on a five-week window, so it is not a focus for this research, but we can see which skill bundles are fusing into new roles, which is the leading edge of the same phenomenon.</p>
    </div>
  </div>
</section>

<!-- ================= KEY FINDINGS ================= -->
<section class="section-alt" id="findings">
  <div class="a-container">
    <span class="a-eyebrow kicker">At a glance</span>
    <h2 class="head">What the data shows</h2>
    <div class="findgrid">
      <div class="find">
        <span class="fnum">01</span>
        <h3>The strongest signal is a role still settling into its name</h3>
        <p>The <span class="em">MLOps Pipeline Engineer</span>, who builds and runs the automated infrastructure to deploy, version, and monitor machine-learning models in production, scores highest on emergence. It bridges <span class="em">ML Engineering, DevOps, and Data Engineering</span>, pulling together MLOps, CI/CD for ML, model registries and versioning, workflow orchestration, and ML observability. Its skill bundle appears in <span class="em">1,582</span> postings (postings whose skills contain the bundle, not postings titled for it), and the validation below matches it to MLOps Engineer, the youngest of the known emergent roles: the detector's top candidate is a role caught while its title is still consolidating across enterprises, not a brand-new invention.</p>
      </div>
      <div class="find">
        <span class="fnum">02</span>
        <h3>The AI frontier is narrower than the hype</h3>
        <p>Exactly one AI bundle ranks among the most-emergent candidates: the <span class="em">LLM Application Engineer</span>, the contemporary AI engineer building on foundation models rather than training them, third by recency across 6,758 postings. Once every bundle's technologies are dated, no candidate's stack has a median birth year later than <span class="em">2019</span>: Fortune&nbsp;500 hiring trails the technology frontier by several years, and the newest tools (post-2023 agent frameworks and the like) have not yet stabilized into any recurring cross-role bundle in this corpus.</p>
      </div>
      <div class="find">
        <span class="fnum">03</span>
        <h3>Employers name the old role, hire the new one</h3>
        <p> Among postings still titled for a familiar role like "AI Engineer" or "ML Engineer," <span class="em">53%</span> already demand the newer skill set: large language models and conversational AI wired through the OpenAI API and Vertex AI, evaluated with structured harnesses like OpenAI Evals. The title names a role employers already know, but the skills describe an emerging one that has no settled name yet.</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= METHOD ================= -->
<section id="method">
  <div class="a-container">
    <span class="a-eyebrow kicker">The method</span>
    <h2 class="head">How we detected emergence in a snapshot</h2>
    <p class="lead narrow">Through seven steps we turn a pile of job postings into a ranked list of forming roles.</p>

    <div class="stepper">
      <div class="step"><div class="n">1</div><h3>Baselines</h3><p>Build each role's "before" two independent ways: taxonomy skill centroids and the profiles of title-pure postings.</p></div>
      <div class="step"><div class="n">2</div><h3>Home roles</h3><p>Assign every skill the established role it historically belongs to, keeping only confident placements.</p></div>
      <div class="step"><div class="n">3</div><h3>Bleed metric</h3><p>Keep skill pairs that co-occur far more than chance, span different home roles, and are not synonyms.</p></div>
      <div class="step"><div class="n">4</div><h3>Communities</h3><p>Cluster the bleed graph alone, so every community bridges two or more historical roles by construction.</p></div>
      <div class="step"><div class="n">5</div><h3>Vintage</h3><p>Date each bundle's technologies; recent stacks rank as live emergence, old stacks as settled hybrids.</p></div>
      <div class="step"><div class="n">6</div><h3>Title divergence</h3><p>Measure how often a posting's title names one role while its skills show the cross-boundary bundle.</p></div>
      <div class="step"><div class="n">7</div><h3>Label</h3><p>A local language model names each isolated bundle from its skills and an example posting.</p></div>
    </div>

    <div class="figure">
      <div class="figtitle">The detection pipeline</div>
      <div class="figsub">We have two independent baselines, role taxonomy and title-pure postings, that converge into the bleed metric. Because neither is derived from Fortune 500 co-occurrence, the method measures drift without circularity.</div>
      <div class="pipe">

        <div class="lane">
          <div class="lane-lbl">Data<small>what we read</small></div>
          <div class="pbox data"><span class="tag">corpus</span><b>47,101</b> Fortune 500 software postings</div>
          <div class="sub-arrow">↓</div>
          <div class="pbox data"><span class="tag">extract</span><b>2,026</b> skills, placed and scored</div>
        </div>

        <div class="flow">▶</div>

        <div class="lane">
          <div class="lane-lbl">Baseline<small>the "before"</small></div>
          <div class="pbox base"><span class="tag">reference A</span>Taxonomy role centroids <span class="mono">(43 software roles)</span></div>
          <div class="sub-arrow">＋</div>
          <div class="pbox base"><span class="tag">reference B</span>Title-pure posting profiles <span class="mono">(single-role titles)</span></div>
        </div>

        <div class="flow">▶</div>

        <div class="lane">
          <div class="lane-lbl">Detection<small>where bleed is measured</small></div>
          <div class="pbox"><span class="tag">step 1</span>Home role per skill</div>
          <div class="sub-arrow">↓</div>
          <div class="pbox"><span class="tag">step 2</span>Bleed metric <span class="mono">lift × cross-home × distance</span></div>
          <div class="sub-arrow">↓</div>
          <div class="pbox"><span class="tag">step 3</span>Bleed graph → Louvain communities</div>
        </div>

        <div class="flow">▶</div>

        <div class="lane">
          <div class="lane-lbl">Output<small>rank and name</small></div>
          <div class="pbox"><span class="tag">signals</span>Vintage + title divergence + LLM label</div>
          <div class="sub-arrow">↓</div>
          <div class="pbox out-final"><span class="tag">result</span><b>23</b> emergent-role candidates</div>
        </div>

      </div>
      <div class="cap">The baseline is the study's "before". Bleed is the gap between it and what employers actually ask for, which is why the two baselines must stay independent of the corpus being searched.</div>
    </div>

    <div class="methcols">
      <div>
        <h3 class="serif">Why a snapshot can detect emergence</h3>
        <p style="margin-top:10px">In an earlier attempt, I recombined clusters drawn from the same co-occurrence graph and simply kept re-finding the obvious. The method presented here breaks that loop by anchoring the "before" to a role taxonomy and to title-pure postings that are independent of the Fortune 500 co-occurrence patterns we are searching. Bleed is then the measurable gap between what a role was supposed to require and what employers are actually asking for.</p>
      </div>
      <div>
        <h3 class="serif">What is distinctive here</h3>
        <ul>
          <li><strong>Cross-sectional bleed.</strong> Emergence is recovered from canonical-versus-observed drift in a single snapshot, not from posting-volume growth over time.</li>
          <li><strong>Technology-vintage scoring.</strong> Dating the stack separates genuinely emerging bleed from long-settled hybrids; the vintage axis stands in for the missing time axis. In the future we will incorporate temporal signals directly into the model (if we can get the data).</li>
          <li><strong>An embedding-distance synonym filter.</strong> Requiring the two bleeding skills to be semantically distant removes the near-synonym noise that defeats volume-based methods.</li>
        </ul>
        <p class="muted" style="font-size:14px">Hybrid-job research already exists (Lightcast, O*NET, ESCO). We do not claim to have invented hybrid roles; the contribution is a snapshot-compatible, taxonomy-anchored, vintage-scored detector.</p>
      </div>
    </div>

    <div class="figure">
      <div class="figtitle">The technical stack</div>
      <div class="figsub">The whole study runs on one local workstation with no external API calls: the corpus, the embedding and language models, and the analysis never leave the machine. This was done to reduce token cost and justify the business case for a new graphics card.</div>
      <div class="arch-boundary">
        

        <div class="arch-row">
          <div class="arch-rlbl">Storage<small>the corpus</small></div>
          <div class="arch-cells">
            <div class="arch-box storage"><span class="bt">PostgreSQL 17</span><div class="bs">Fortune 500 SDLC job postings and the skills extracted from them</div></div>
          </div>
        </div>

        <div class="arch-row">
          <div class="arch-rlbl">Inference<small>local models</small></div>
          <div class="arch-cells">
            <div class="arch-box infer"><span class="bt">qwen3-embedding:8b</span><div class="bs">Embeddings for skill and role matching <span class="mono">4096-d</span></div></div>
            <div class="arch-box infer"><span class="bt">gemma4</span><div class="bs">Names each detected bundle: labeling only, never detection</div></div>
            <div class="arch-box index"><span class="bt">FAISS</span><div class="bs">Vector index over the role and skill taxonomy</div></div>
          </div>
        </div>

        <div class="arch-down">▼</div>

        <div class="arch-row">
          <div class="arch-rlbl">Pipeline<small>Python</small></div>
          <div class="arch-cells">
            <div class="arch-box pipe"><span class="bt">Skill-bleed mining pipeline</span><div class="bs">Baselines → home role per skill → bleed metric → bleed graph → Louvain communities → vintage score → label</div></div>
          </div>
        </div>

        <div class="arch-side">
          <div class="arch-rlbl">Config &amp; data<small>side inputs</small></div>
          <div class="arch-cells">
            <div class="arch-box config"><div class="bs"><span class="mono">pure_title_roles.yaml</span> · <span class="mono">tech_vintage.json</span> · skill blocklist · canonical skill map</div></div>
          </div>
        </div>

        <div class="arch-down">▼</div>

        <div class="arch-row">
          <div class="arch-rlbl">Output<small>artifacts</small></div>
          <div class="arch-cells">
            <div class="arch-box out"><span class="bt">Detected candidates</span><div class="bs"><span class="mono">emergent_v3_bleed.json / .md</span> → interactive dashboard → this research page</div></div>
          </div>
        </div>

      </div>
      <div class="cap">Keeping inference local is a deliberate constraint: the analysis costs nothing in external API spend, and no posting or skill data is sent to a third party.</div>
    </div>
  </div>
</section>

<!-- ================= LANDSCAPE ================= -->
<section class="section-alt" id="landscape">
  <div class="a-container">
    <span class="a-eyebrow kicker">The findings</span>
    <h2 class="head">The candidate landscape</h2>
    <p class="lead narrow">Twenty-three candidate roles, read along two independent axes. <b>Bleed</b> asks how far a bundle reaches <i>across</i> established roles, irrespective of age. <b>Recency</b> asks whether a bundle is built on <i>new</i> technology, which is the primary ranking, and where the newest stacks rise to the top. The two rarely coincide: the newest bundles aren't the most cross-cutting, and the bundles that bleed the widest are often long-settled. A low recency score isn't a weak finding but a real cross-role bundle that emerged years ago and stuck.</p>

    <!-- ranking chart: bleed axis -->
    <div class="figure">
      <div class="figtitle">Which bundles bleed across the most roles</div>
      <div class="figsub">Bar length is each bundle's <em>bleed</em> score (0–1): how far its skills spread across established job roles. A high score means the same skill combination keeps showing up in postings for many different traditional roles, rather than sitting inside any single one (a bundle no existing job fully owns). The small figure beside each name is coverage (how many postings it appears in). <b>This view ranks all 23 candidates by bleed alone.</b></div>
      <div id="rankchart">
        {initialRows.map((cand) => {
          const bl = cand.bleed;
          const pct = bl === null || bl === undefined ? 0 : Math.max(2, bl * 100);
          return (
            <div class="rank-row">
              <div class="nm">{cand.label}</div>
              <div class="cov">{fmt(cand.coverage)}</div>
              <div class="bar-track"><div class="bar-fill" data-w={pct} style={`width:${pct}%;background:var(--a-emerald)`}></div></div>
              <div class="sc">{bl === null || bl === undefined ? '–' : bl.toFixed(3)}</div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- emergence map: recency × bleed -->
    <div class="figure" style="position:relative">
      <div class="figtitle">The emergence map: recency × bleed</div>
      <div class="figsub">Each dot is a candidate. Horizontal: the median birth-year of its defining technologies (right = newer). Vertical: its cross-role bleed score (up = wider). Dot size is posting coverage. The top-right corner is the genuinely emerging frontier with roles that are new <em>and</em> cross-cutting. Candidates whose skills have no datable vintage sit in the left lane, placed by bleed. Dated bundles with median vintages before 1990 are pinned to the left edge of the axis.</div>
      <svg id="timeline" height="470" role="img" aria-label="Scatter plot of 23 candidate roles by technology recency and cross-role bleed. The catalog table further down lists the same candidates with their bleed and recency scores in text form."></svg>
      <div class="gtip" id="ttip"></div>
      <div class="cap">The widest-bleeding bundles are frequently older or undatable: cross-cutting is not the same as new.</div>
    </div>

    <!-- bleed graph -->
    <div style="margin-top:54px">
      <h3 class="serif" style="font-size:1.5rem">The bleed graph</h3>
      <p class="narrow" style="margin-top:10px">Each point is a skill. A line connects two skills only when they co-occur far more than chance, belong to <em>different</em> established roles, and are not synonyms, which is the signal of skill bleed. Communities in this graph are the candidate roles: each dense cluster is one bundle. Shown here: a 200-skill subsample carrying 2,713 of the full graph's 4,093 edges. You can drag, scroll to zoom, and hover any point but it's mainly here because it looks cool.</p>
      <div id="graph"><div class="gtip" id="gtip"></div></div>
      <div class="a-visually-hidden">
      <table style="table-layout:fixed;width:300px">
        <caption>The most cross-role-connected skills in the subsampled bleed graph, by posting count. A screen-reader/crawler-visible equivalent of the force diagram above.</caption>
        <thead><tr><th>Skill</th><th>Taxonomy home role</th><th>Postings</th></tr></thead>
        <tbody>
          {topSkills.map((s) => (
            <tr><td>{s.id}</td><td>{s.home}</td><td>{fmt(s.pc)}</td></tr>
          ))}
        </tbody>
      </table>
      </div>
    </div>
  </div>
</section>

<!-- ================= FEATURED ================= -->
<section id="featured">
  <div class="a-container">
    <span class="a-eyebrow kicker">The roles taking shape</span>
    <h2 class="head">Six emerging roles, up close</h2>
    <p class="lead narrow">The six candidates ranked highest on <b>recency</b> from the newest to the freshly settled. This is deliberately a different six from the widest-<i>bleeding</i> bundles charted just above: recency asks how new a bundle's tech is, bleed asks how far it reaches across roles, and the two rarely pick the same leaders. Each card shows the established roles the bundle draws from and the skills doing the bridging.</p>
    <div class="blegend">
      <div class="row"><span class="badge live">Emerging</span><span class="badge warm">Recent</span><span class="badge stable">Settled</span><span>The recency band, from the bundle's median technology birth year: 2018 or later, 2010 to 2017, before 2010. The number beside the badge is the recency score, 0 to 1.</span></div>
      <div class="row"><span class="badge canon">In canon</span><span>Standard occupation dictionaries already name this role.</span></div>
      <div class="row"><span class="badge wild">In the wild</span><span>Fortune 500 hiring shows it, but no dictionary names it yet. Hover any badge for detail.</span></div>
    </div>
    <div class="feat" id="featured-cards">
      {CANDS.slice(0, 6).map((cand) => (
        <Fragment set:html={cardHTML(cand)} />
      ))}
    </div>
  </div>
</section>

<!-- ================= CATALOG ================= -->
<section class="section-tint" id="catalog">
  <div class="a-container">
    <span class="a-eyebrow kicker">The full set</span>
    <h2 class="head">Every candidate, ranked</h2>
    <p class="lead narrow">All 23 detected bundles, sorted by <b>Bleed</b> (how far each crosses established roles) by default. Click any column heading to re-sort, including by <b>Recency</b> (how new the tech is). Each recency cell shows how many of the bundle's top skills carry a datable vintage; a median resting on one or two dated skills is a weak estimate. Coverage counts postings containing a bundle; bundles overlap, so coverage summed across all 23 exceeds the 47,101-posting corpus. "In the wild" marks roles coherent in Fortune 500 hiring but not yet named in the standard occupation dictionaries and "in canon" marks roles those dictionaries already widely recognize. One candidate (Android XR Developer) is flagged as a detection artifact from the manual audit; see the limitations section.</p>
    <div class="tablewrap">
      <table id="catalog-table">
        <caption class="a-visually-hidden">All 23 detected emergent-role candidates with bleed score, recency, posting coverage, home-role mix, and status. Sortable by column; click or activate a row for full details.</caption>
        <thead><tr>
          <th data-k="bleed" class="sortable"><button type="button" class="th-btn">#</button></th>
          <th data-k="label" class="sortable"><button type="button" class="th-btn">Emergent role</button></th>
          <th data-k="bleed" class="sortable"><button type="button" class="th-btn">Bleed <span class="ar">▾</span></button></th>
          <th data-k="emergence" class="sortable"><button type="button" class="th-btn">Recency</button></th>
          <th data-k="coverage" class="sortable"><button type="button" class="th-btn">Postings</button></th>
          <th class="hide-sm">Bridges</th>
          <th class="hide-sm">Status</th>
        </tr></thead>
        <tbody>
          {initialRows.map((cand) => {
            const rc = recencyCell(cand);
            const bl = cand.bleed;
            const status = cand.canon === 'in-the-wild'
              ? '<span class="badge wild" title="Detected as a coherent bundle in Fortune 500 hiring, but standard occupation dictionaries (O*NET, ESCO, Lightcast) do not yet name it as a role">in the wild</span>'
              : '<span class="badge canon" title="A role that standard occupation dictionaries (O*NET, ESCO, Lightcast) already recognize by name">in canon</span>';
            const statusFull = status + (cand.artifact ? ' <span class="badge na" title="Flagged in the July 2026 manual audit as a detection artifact: no XR-specific skills; cross-home edges come from Android tooling split across Mobile and VR/AR home roles">artifact</span>' : '');
            return (
              <tr class="crow" data-rank={cand.rank} tabindex="0" role="button" aria-expanded="false" aria-label={`${cand.label}, toggle details`}>
                <td class="rk"><span class="chev">▸</span>{bleedRank.get(cand.rank)}</td>
                <td class="role">{cand.label}</td>
                <td>
                  {bl === null || bl === undefined ? (
                    <span class="minibar"><span class="mv">–</span></span>
                  ) : (
                    <span class="minibar"><span class="mt"><span class="mf" style={`width:${Math.max(3, bl * 100)}%;background:#307C84`}></span></span><span class="mv">{bl.toFixed(2)}</span></span>
                  )}
                </td>
                <td>
                  {rc.band === 'na' ? (
                    <><span class="rband na">not scored</span><span class="rdated">{cand.n_dated}/{cand.n_top} dated</span></>
                  ) : (
                    <><span class="ryear">{rc.yr}</span><span class={`rband ${rc.band}`}>{rc.label}</span><span class="rdated">{cand.n_dated}/{cand.n_top} dated</span></>
                  )}
                </td>
                <td class="cov">{fmt(cand.coverage)}</td>
                <td class="mix hide-sm">{summaryMix(cand.home_mix)}</td>
                <td class="hide-sm" set:html={statusFull}></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ================= VALIDATION ================= -->
<section id="validation">
  <div class="a-container">
    <span class="a-eyebrow kicker">The evidence</span>
    <h2 class="head">How we know the signal is real</h2>
    <p class="lead narrow">The tests below were specified before the results were read, with two post-hoc refinements made and disclosed: the recall signatures and the clustering resolution (final values in the reproducibility note at the end of the page).</p>
    <div class="valgrid">
      <div class="valcard"><div class="vn">5/7</div><div class="vl">Known emergent roles recovered as candidates</div></div>
      <div class="valcard"><div class="vn">96%</div><div class="vl">Candidates judged non-artifact (22/23) in a single-rater manual audit of this run's full output</div></div>
      <div class="valcard"><div class="vn">z = −50</div><div class="vl">Null-model separation: real role labels remove far more within-role noise than random labels</div></div>
      <div class="valcard"><div class="vn">8%</div><div class="vl">Bleed edges flagged as possible near-synonyms in a 200-edge embedding audit</div></div>
    </div>
    <p class="narrow" style="margin-top:26px;font-size:14.5px;color:var(--a-text-muted)">Behind the bleed metric, every skill's home-role assignment had to survive the two-baseline check: of the 2,026 scored skills, 596 were placed identically by both baselines, 432 agreed within the top three, 393 rest on the taxonomy alone (no title-pure evidence either way), and 605 low-confidence placements were excluded from the graph entirely.</p>
    <div class="recall" id="recall-list">
      <h3 class="serif">The seven roles we knew should appear, and five did</h3>
      {Object.entries(VAL.recall.detail).map(([known, d]) => (
        !d ? (
          <div class="rrow miss">
            <span class="ck">✗</span>
            <span class="known">{known}</span>
            <span class="arrow">not recovered</span>
            <span class="into" style="color:var(--a-text-muted)">no candidate matched this role</span>
          </div>
        ) : (
          <div class="rrow">
            <span class="ck">✓</span>
            <span class="known">{known}</span>
            <span class="arrow">recovered as</span>
            <span class="into">#{d.candidate_index + 1} {d.candidate_label}</span>
            <span class="sk" style="margin-left:auto">{(d.matched_skills || []).slice(0, 4).join(', ')}</span>
          </div>
        )
      ))}
    </div>
  </div>
</section>

<!-- ================= LIMITATIONS ================= -->
<section class="section-alt" id="limits">
  <div class="a-container">
    <span class="a-eyebrow kicker">Honest disclosure</span>
    <h2 class="head">What this study does not claim</h2>
    <div class="limits">
      <div class="lim"><span class="dot"></span><div><h3>It is a snapshot, not a trend</h3><p>Emergence is inferred from canonical drift and technology vintage, never from posting-date growth. The corpus spans about five weeks.</p></div></div>
      <div class="lim"><span class="dot"></span><div><h3>It reflects US Fortune 500 hiring</h3><p>The corpus is large-enterprise and software-role filtered. Findings generalize to that population, not the whole labor market.</p></div></div>
      <div class="lim"><span class="dot"></span><div><h3>Skill extraction is imperfect</h3><p>An importance floor, a canonical-name map, and a blocklist reduce extraction noise but do not eliminate it; residual false positives (e.g. design tools inside the LLM bundle) stay visible in the skill lists rather than being silently removed. A single-rater manual audit of all 23 candidates (July 2026) flagged one as an artifact: Android XR Developer, whose cross-home edges come from the taxonomy splitting Android tooling across Mobile and VR/AR home roles. It is kept visible and flagged in the catalog rather than hidden.</p></div></div>
      <div class="lim"><span class="dot"></span><div><h3>Technology dating is fuzzy</h3><p>Birth years are judgment calls drawn from a versioned, auditable lookup and the emergence score is a rank, not a precise date. Several bundles' medians rest on only one or two dated skills; the catalog shows each bundle's dated-skill coverage.</p></div></div>
      <div class="lim"><span class="dot"></span><div><h3>Ubiquitous skills carry no signal</h3><p>A skill that co-occurs with nearly everything produces no bleed edge by design, so it is absent from the graph. A feature of the method, not a gap.</p></div></div>
      <div class="lim"><span class="dot"></span><div><h3>Hybrid jobs are prior art</h3><p>The phenomenon is well established in the literature. Our contribution is the snapshot-compatible, taxonomy-anchored, vintage-scored detection method.</p></div></div>
    </div>
  </div>
</section>

<!-- ================= CLOSING ================= -->
<section class="section-dark closing">
  <div class="a-container">
    <span class="a-eyebrow kicker">Why it matters</span>
    <h2 class="serif">Reading skills, not titles</h2>
    <p>Andela assesses, matches, places, and upskills engineering talent to help enterprises adopt AI responsibly in production. This study is part of how we read the technology talent market by its skills rather than its job titles to see which capabilities are compounding in value before the labels catch up. We also use this data to help tailor learning programs ahead of anyone else in the market.</p>
    <p>As skill half-lives shorten, the roles forming in the gaps between today's jobs are where tomorrow's talent debt accrues so seeing them early is the point and why I did this.</p>
    <div class="repro">
      <strong style="color:#fff">Reproducibility.</strong> Corpus collected 30 March to 2 May 2026 from public Fortune 500 job boards; detected from 47,101 SDLC postings, 2,026 skills scored, on a cross-role bleed graph of 4,093 edges. Embeddings <span class="mono">qwen3-embedding:8b</span> at acceptance threshold 0.55. Bleed edges require co-occurrence support ≥ 60 and lift ≥ 1.3, with a synonym cosine cutoff of 0.78. Louvain resolution 4.0, seed 42 (deterministic); communities kept at ≥ 5 skills, ≥ 5 internal edges, coverage ≥ 120 postings, and hub share ≤ 0.55. Null model: 20 home-label permutations. Recency band: technologies born 2023 or later, the three years preceding the run. Generated 16 June 2026. If you made it to here, ask me for a dollar next time I see you.
    </div>
  </div>
</section>


